@startuml ClassDiagram_Full

' ============================================================
'  JEU DE DAMES — DIAGRAMME COMPLET
'  MODEL + VIEW + CONTROLLER + PERSISTENCE
' ============================================================

skinparam linetype ortho
skinparam nodesep 45
skinparam ranksep 60
skinparam shadowing false
skinparam roundCorner 10
skinparam classAttributeIconSize 0
hide circle

skinparam class {
    FontSize 13
    FontStyle bold
    AttributeFontSize 11
    BorderThickness 1.5
    BackgroundColor<<model>>      #EBF5FB
    BorderColor<<model>>          #2E86C1
    BackgroundColor<<ai>>         #E8F8F5
    BorderColor<<ai>>             #117A65
    BackgroundColor<<enumc>>      #FEF9E7
    BorderColor<<enumc>>          #D4AC0D
    BackgroundColor<<view>>       #FDEDEC
    BorderColor<<view>>           #CB4335
    BackgroundColor<<controller>> #E9F7EF
    BorderColor<<controller>>     #229954
    BackgroundColor<<persist>>    #F4ECF7
    BorderColor<<persist>>        #7D3C98
}

title <size:17><b>Jeu de Dames — Diagramme de Classes Complet</b></size>\n<size:11>MODEL · VIEW · CONTROLLER · PERSISTENCE</size>\n

' ============================================================
'  ÉNUMÉRATIONS
' ============================================================
enum PieceColor <<enumc>> {
    WHITE
    BLACK
    --
    + opposee() : PieceColor
}
enum GameState <<enumc>> {
    EN_COURS
    VICTOIRE_BLANC
    VICTOIRE_NOIR
    NUL
}

' ============================================================
'  MODEL — Hiérarchie des pièces
' ============================================================
abstract class Piece <<model>> {
    - couleur : PieceColor
    - position : Position
    --
    + getCouleur() : PieceColor
    + getPosition() : Position
    + setPosition(position) : void
    + {abstract} getCoupsPossibles(plateau) : List<Move>
    + {abstract} peutEtrePromu() : boolean
    + {abstract} getCapturesImmediates(plateau, depart) : List<int[]>
}

class Pawn <<model>> {
    + getCoupsPossibles(plateau) : List<Move>
    + peutEtrePromu() : boolean
    + getCapturesImmediates(plateau, depart) : List<int[]>
}

class King <<model>> {
    + getCoupsPossibles(plateau) : List<Move>
    + peutEtrePromu() : boolean
    + getCapturesImmediates(plateau, depart) : List<int[]>
}

' ============================================================
'  MODEL — Objets valeur
' ============================================================
class Position <<model>> {
    - ligne : int
    - colonne : int
    --
    + getLigne() : int
    + getColonne() : int
    + {static} estValide(ligne, colonne) : boolean
}

class Move <<model>> {
    - depart : Position
    - arrivee : Position
    - positionsCapturees : List<Position>
    - estPromotion : boolean
    --
    + getDepart() : Position
    + getArrivee() : Position
    + getPositionsCapturees() : List<Position>
    + ajouterCapturee(pos) : void
    + estCapture() : boolean
    + estPromotion() : boolean
}

' ============================================================
'  MODEL — Plateau & Règles
' ============================================================
class Board <<model>> {
    - {static} TAILLE : int = 8
    - grille : Piece[][]
    --
    + initialiser() : void
    + getPiece(position) : Piece
    + appliquerCoup(coup) : void
    + appliquerCoup(coup, memoriser) : MoveUndo
    + annulerCoup(undo) : void
    + getToutesLesPieces() : List<Piece>
    + copier() : Board
}

class GameRules <<model>> {
    + {static} getCoupsLegaux(plateau, couleur) : List<Move>
    + {static} estCoupValide(plateau, coup, couleur) : boolean
    + {static} getCoupsValidesPour(piece, plateau) : List<Move>
    + {static} getCapturesObligatoires(plateau, couleur) : List<Move>
    + {static} aGagne(plateau, couleur) : boolean
    - {static} chercherCaptures(plateau, piece, origine, depart, ...) : void
}

' ============================================================
'  MODEL — Orchestrateur & Joueurs
' ============================================================
class Game <<model>> {
    - {static} SEUIL_NULLE : int = 40
    - plateau : Board
    - joueurs : Player[2]
    - indexCourant : int
    - etat : GameState
    - coupsSansProgres : int
    --
    + getJoueurCourant() : Player
    + getJoueur(i) : Player
    + getPlateau() : Board
    + estTerminee() : boolean
    + getGagnant() : Player
    + jouerCoup(coup) : boolean
}

abstract class Player <<model>> {
    # nom : String
    # couleur : PieceColor
    --
    + getNom() : String
    + getCouleur() : PieceColor
    + {abstract} estHumain() : boolean
}

class HumanPlayer <<model>> {
    + estHumain() : boolean
}

class AIPlayer <<model>> {
    - ia : MinimaxAI
    --
    + estHumain() : boolean
    + choisirCoup(partie) : Move
}

' ============================================================
'  IA
' ============================================================
class MinimaxAI <<ai>> {
    - {static} PROFONDEUR : int = 4
    --
    + trouverMeilleurCoup(partie) : Move
    - minimax(plateau, profondeur, alpha, beta, maximise, couleurIA) : int
    - {static} evaluer(plateau, couleur) : int
}

' ============================================================
'  VIEW
' ============================================================
class BoardView <<view>> {
    - {static} TAILLE_CASE : int = 72
    - {static} TAILLE_PIECE : int = 56
    - cases : StackPane[][]
    - caseSelectionnee : Position
    - casesJouables : Set<Position>
    --
    + rafraichir(plateau) : void
    + marquerSelection(pos) : void
    + marquerCoups(positions) : void
    + effacerMarques() : void
    + glisserPiece(depart, arrivee) : void
    + signalerCaptures(positions) : void
    + arreterAlerteCapture() : void
}

interface BoardViewListener <<view>> {
    + onCaseCliquee(pos) : void
    + onPieceGlissee(depart, arrivee) : void
}

' ============================================================
'  CONTROLLER
' ============================================================
class AppController <<controller>> {
    - fenetre : Stage
    --
    + afficherMenu() : void
    + afficherConfig(mode) : void
    + afficherPartie(nomJoueur1, nomJoueur2, mode) : void
    + afficherScores() : void
    + afficherFin(nomGagnant) : void
}

class MenuController <<controller>> {
    - appController : AppController
    --
    + definirAppController(ac) : void
    + jouerContreHumain() : void
    + jouerContreIA() : void
    + afficherScores() : void
    + quitter() : void
}

class LoginController <<controller>> {
    - appController : AppController
    --
    + definirAppController(ac) : void
    + definirMode(mode) : void
    + confirmer() : void
    - majChampJoueur2() : void
}

class GameController <<controller>> {
    - appController : AppController
    - partie : Game
    - vuePlateau : BoardView
    - caseSelectionnee : Position
    - iaReflechit : boolean
    --
    + definirAppController(ac) : void
    + demarrerPartie(nom1, nom2, mode) : void
    + onCaseCliquee(pos) : void
    + onPieceGlissee(depart, arrivee) : void
    + jouerTourIA() : void
    + terminerPartie() : void
    - majInterface() : void
}

class ScoresController <<controller>> {
    - appController : AppController
    - tableauScores : TableView<ScoreEntry>
    --
    + definirAppController(ac) : void
    + initialize() : void
    + retour() : void
}

class EndGameController <<controller>> {
    - appController : AppController
    --
    + definirAppController(ac) : void
    + definirGagnant(nomGagnant) : void
    + rejouer() : void
    + retournerAuMenu() : void
}

' ============================================================
'  PERSISTENCE
' ============================================================
class DatabaseManager <<persist>> {
    - {static} connexion : Connection
    --
    + {static} getConnexion() : Connection
}

class PlayerDAO <<persist>> {
    + {static} ajouterJoueur(nom) : void
    - {static} joueurExiste(nom) : boolean
}

class GameDAO <<persist>> {
    + {static} enregistrerPartie(joueur1, joueur2, gagnant, mode) : void
}

class ScoreDAO <<persist>> {
    + getMeilleursScores() : List<ScoreEntry>
    + mettreAJourScore(nom, victoire) : void
}

class ScoreEntry <<persist>> {
    - nom : StringProperty
    - partiesJouees : IntegerProperty
    - victoires : IntegerProperty
    - points : IntegerProperty
    --
    + getNom() : String
    + getPartiesJouees() : int
    + getVictoires() : int
    + getPoints() : int
    + nomProperty() : StringProperty
    + partiesJoueesProperty() : IntegerProperty
    + victoiresProperty() : IntegerProperty
    + pointsProperty() : IntegerProperty
}

' ============================================================
'  RELATIONS — MODEL
' ============================================================
Piece     <|-- Pawn
Piece     <|-- King
Player    <|-- HumanPlayer
Player    <|-- AIPlayer
Game      *-- "1"     Board     : contient
Game      *-- "2"     Player    : oppose
Board     *-- "0..24" Piece     : contient
AIPlayer  *-- "1"     MinimaxAI : possède

' ============================================================
'  RELATIONS — VIEW / CONTROLLER
' ============================================================
BoardViewListener  <|..          GameController
GameController     -->           BoardView         : rafraîchit
BoardView          -->           BoardViewListener : notifie

MenuController     -->  AppController : navigue
LoginController    -->  AppController : navigue
GameController     -->  AppController : navigue
EndGameController  -->  AppController : navigue
ScoresController   -->  AppController : navigue

' ============================================================
'  NOTES
' ============================================================
note bottom of Piece
  <b>Classe abstraite</b>
  Pawn et King redéfinissent
  getCoupsPossibles() et getCapturesImmediates()
  selon leurs règles propres.
end note

note right of GameRules
  <b>Toutes méthodes statiques.</b>
  Prise obligatoire + maximale.
  chercherCaptures() est récursive.
end note

note right of AppController
  <b>Routeur central</b>
  Charge les FXML, injecte this
  dans chaque contrôleur.
end note

note bottom of DatabaseManager
  <b>Connexion statique partagée.</b>
  Identifiants lus depuis config.properties.
end note

legend bottom
  <back:#EBF5FB>   </back> Model   <back:#E8F8F5>   </back> IA   <back:#FEF9E7>   </back> Énumération
  <back:#FDEDEC>   </back> View    <back:#E9F7EF>   </back> Controller   <back:#F4ECF7>   </back> Persistence
  ──▷ Héritage      ◆── Composition      ──> Association
endlegend

@enduml
