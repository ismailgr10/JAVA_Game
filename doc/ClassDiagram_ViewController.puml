@startuml ClassDiagram_ViewController

' ============================================================
'  JEU DE DAMES — DIAGRAMME 2/2 : VIEW + CONTROLLER + PERSISTENCE
'  Architecture : JavaFX + Scene Builder (FXML)
' ============================================================

skinparam linetype ortho
skinparam nodesep 45
skinparam ranksep 60
skinparam shadowing false
skinparam roundCorner 10
skinparam classAttributeIconSize 0
hide circle

skinparam class {
    FontSize 13
    FontStyle bold
    AttributeFontSize 11
    BorderThickness 1.5
    BackgroundColor<<view>>       #FDEDEC
    BorderColor<<view>>           #CB4335
    BackgroundColor<<controller>> #E9F7EF
    BorderColor<<controller>>     #229954
    BackgroundColor<<persist>>    #F4ECF7
    BorderColor<<persist>>        #7D3C98
    BackgroundColor<<model>>      #EBF5FB
    BorderColor<<model>>          #2E86C1
    BackgroundColor<<fxml>>       #FEF9E7
    BorderColor<<fxml>>           #D4AC0D
}

title <size:17><b>Jeu de Dames — Diagramme de Classes (2/2)</b></size>\n<size:11>Couches VIEW, CONTROLLER et PERSISTENCE — JavaFX + FXML</size>\n

' ============ VUES FXML ============
note as FXMLNote
  <b>Vues FXML</b> (Scene Builder)
  Ces fichiers ne sont pas des classes Java.
  Chaque .fxml déclare son contrôleur via fx:controller.
  ──────────────────────────────────
  • MenuView.fxml      → MenuController
  • LoginView.fxml     → LoginController
  • GameView.fxml      → GameController
  • ScoresView.fxml    → ScoresController
  • EndGameView.fxml   → EndGameController
end note

' ============ VIEW ============
class BoardView <<view>> {
    - {static} CELL_SIZE : int = 72
    - {static} PIECE_SIZE : int = 56
    - cells : StackPane[][]
    - selectedPos : Position
    - movable : Set<Position>
    - dragFrom : Position
    --
    + refresh(board) : void
    + highlightSelected(pos) : void
    + highlightMoves(positions) : void
    + clearHighlights() : void
}

interface BoardViewListener <<view>> {
    + onCellClicked(pos) : void
    + onMoveDragged(from, to) : void
}

' ============ CONTROLLER ============
class AppController <<controller>> {
    - stage : Stage
    --
    + showMenu() : void
    + showLogin(mode) : void
    + showGame(player1Name, player2Name, mode) : void
    + showScores() : void
    + showEndGame(winnerName) : void
}

class MenuController <<controller>> {
    - appController : AppController
    --
    + setAppController(ac) : void
    + onJouerHumain() : void
    + onJouerIA() : void
    + onScores() : void
    + onQuitter() : void
}

class LoginController <<controller>> {
    - appController : AppController
    - mode : String
    + usernameField : TextField
    + modeLabel : Label
    --
    + setAppController(ac) : void
    + setMode(mode) : void
    + onConfirm() : void
    + onBack() : void
}

class GameController <<controller>> {
    - appController : AppController
    - game : Game
    - boardView : BoardView
    - selectedCell : Position
    + currentPlayerLabel : Label
    + timerLabel : Label
    + captureCountLabel : Label
    --
    + setAppController(ac) : void
    + startGame(player1Name, player2Name, mode) : void
    + onCellClicked(pos) : void
    + onMoveDragged(from, to) : void
    + handleAITurn() : void
    + handleEndGame() : void
    + updateUI() : void
}

class ScoresController <<controller>> {
    - appController : AppController
    - tableScores : TableView<ScoreEntry>
    - colNom : TableColumn
    - colParties : TableColumn
    - colVictoires : TableColumn
    - colPoints : TableColumn
    --
    + setAppController(ac) : void
    + initialize() : void
    + onRetour() : void
}

class EndGameController <<controller>> {
    - appController : AppController
    - winnerName : String
    + resultLabel : Label
    --
    + setAppController(ac) : void
    + setWinner(winnerName) : void
    + onPlayAgain() : void
    + onBackToMenu() : void
}

' ============ PERSISTENCE ============
class DatabaseManager <<persist>> {
    - {static} connexion : Connection
    --
    + {static} getConnexion() : Connection
    + {static} fermerConnexion() : void
}

class PlayerDAO <<persist>> {
    + {static} ajouterJoueur(nom) : void
    + {static} joueurExiste(nom) : boolean
}

class GameDAO <<persist>> {
    + {static} enregistrerPartie(joueur1, joueur2, gagnant, mode) : void
}

class ScoreDAO <<persist>> {
    + getTopScores() : List<ScoreEntry>
    + mettreAJourScore(nom, victoire) : void
}

class ScoreEntry <<persist>> {
    - nom : StringProperty
    - partiesJouees : IntegerProperty
    - victoires : IntegerProperty
    - points : IntegerProperty
    --
    + getNom() : String
    + getPartiesJouees() : int
    + getVictoires() : int
    + getPoints() : int
    + nomProperty() : StringProperty
    + partiesJoueesProperty() : IntegerProperty
    + victoiresProperty() : IntegerProperty
    + pointsProperty() : IntegerProperty
}

' --- Relations : implémentation ---
BoardViewListener <|.. GameController

' --- Relations : BoardView ---
GameController --> BoardView         : rafraîchit
BoardView      --> BoardViewListener : notifie (listener injecté via constructeur)

' --- Relations : navigation via AppController ---
MenuController    --> AppController : navigue
LoginController   --> AppController : navigue
EndGameController --> AppController : navigue
ScoresController  --> AppController : navigue

' --- Relations : Persistence ---
PlayerDAO  ..> DatabaseManager : utilise
GameDAO    ..> DatabaseManager : utilise
ScoreDAO   ..> DatabaseManager : utilise
ScoreDAO   ..> ScoreEntry      : produit

' --- Relations : Controller utilise Persistence ---
ScoresController ..> ScoreDAO : interroge

note top of GameController
  <b>Squelette</b> — à implémenter.
  Implémentera BoardViewListener,
  recevra les clics/drag de BoardView,
  déléguera à GameRules et Board.
end note

note top of AppController
  <b>Routeur central</b>
  Charge les FXML via FXMLLoader,
  injecte this dans chaque controller,
  gère les transitions d'écran via Stage.setScene().
end note

note bottom of DatabaseManager
  <b>Connexion statique partagée</b>
  (pattern Singleton sans getInstance).
  Credentials lus depuis config.properties.
end note

note right of BoardView
  <b>Vue programmatique (pas FXML)</b>
  Extends GridPane. Affiche les cases
  (StackPane) et pions (ImageView).
  Listener injecté via constructeur.
  Aucune règle métier ici.
end note

legend bottom
  <back:#FDEDEC>   </back> View (JavaFX)   <back:#E9F7EF>   </back> Controller (@FXML)   <back:#F4ECF7>   </back> Persistence   <back:#EBF5FB>   </back> Model (rappel)   <back:#FEF9E7>   </back> Vues FXML (fichiers XML)
  ──▷ Héritage   ┄┄▷ Implémentation / Dépendance   ──> Association   ◆── Composition
endlegend

@enduml
