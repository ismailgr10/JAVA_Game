@startuml ClassDiagram_ViewController

' ============================================================
'  JEU DE DAMES — DIAGRAMME 2/2 : VIEW + CONTROLLER + PERSISTENCE
'  Architecture : JavaFX 21 + Scene Builder (FXML)
' ============================================================

skinparam linetype ortho
skinparam nodesep 45
skinparam ranksep 60
skinparam shadowing false
skinparam roundCorner 10
skinparam classAttributeIconSize 0
hide circle

skinparam class {
    FontSize 13
    FontStyle bold
    AttributeFontSize 11
    BorderThickness 1.5
    BackgroundColor<<view>>       #FDEDEC
    BorderColor<<view>>           #CB4335
    BackgroundColor<<controller>> #E9F7EF
    BorderColor<<controller>>     #229954
    BackgroundColor<<persist>>    #F4ECF7
    BorderColor<<persist>>        #7D3C98
    BackgroundColor<<model>>      #EBF5FB
    BorderColor<<model>>          #2E86C1
    BackgroundColor<<fxml>>       #FEF9E7
    BorderColor<<fxml>>           #D4AC0D
}

title <size:17><b>Jeu de Dames — Diagramme de Classes (2/2)</b></size>\n<size:11>Couches VIEW, CONTROLLER et PERSISTENCE — JavaFX 21 + FXML</size>\n

' --- Référence vers le Model (grisée, pour le contexte) ---
class Game <<model>> {
    + tryPlay(move) : boolean
    + isOver() : boolean
}

' ============ VIEW (FXML — fichiers XML, pas des classes Java) ============
note as FXMLNote
  <b>Vues FXML</b> (Scene Builder)
  Ces fichiers ne sont pas des classes Java.
  Chaque .fxml déclare son contrôleur via fx:controller.
  ──────────────────────────────────
  • MenuView.fxml      → MenuController
  • LoginView.fxml     → LoginController
  • GameView.fxml      → GameController
  • ScoresView.fxml    → ScoresController
  • EndGameView.fxml   → EndGameController
end note

' --- Seule vraie classe View Java (plateau dynamique, pas de FXML) ---
class BoardView <<view>> {
    - {static} CELL_SIZE : int = 70
    - cells : Rectangle[][]
    - pieces : Circle[][]
    - selectedPos : Position
    --
    + setBoard(board) : void
    + setSelected(pos) : void
    + clearHighlights() : void
    + setListener(l) : void
    - initGrid() : void
    - drawPieces(board) : void
}

interface BoardViewListener <<view>> {
    + onCellClicked(pos) : void
    + onMoveDragged(from, to) : void
}

' ============ CONTROLLER ============
class AppController <<controller>> {
    - stage : Stage
    --
    + start(stage) : void
    + showMenu() : void
    + showLogin(mode) : void
    + showGame(p1, p2) : void
    + showScores() : void
    + showEndGame(result) : void
    - loadFXML(fxml) : Scene
}

class MenuController <<controller>> {
    - appController : AppController
    --
    + onNewGameVsHuman() : void
    + onNewGameVsAI() : void
    + onShowScores() : void
    + onQuit() : void
}

class LoginController <<controller>> {
    - appController : AppController
    + usernameField : TextField
    + modeLabel : Label
    --
    + onConfirm() : void
    + onBack() : void
}

class GameController <<controller>> {
    - game : Game
    - boardView : BoardView
    - selectedCell : Position
    + currentPlayerLabel : Label
    + timerLabel : Label
    + captureCountLabel : Label
    --
    + onCellClicked(pos) : void
    + onMoveDragged(from, to) : void
    + handleAITurn() : void
    + handleEndGame() : void
    + updateUI() : void
}

class ScoresController <<controller>> {
    + scoresTable : TableView
    --
    + initialize() : void
    + loadScores() : void
    + onBack() : void
}

class EndGameController <<controller>> {
    - appController : AppController
    + resultLabel : Label
    --
    + setResult(state) : void
    + onPlayAgain() : void
    + onBackToMenu() : void
}

' ============ PERSISTENCE ============
class DatabaseManager <<persist>> {
    - {static} instance : DatabaseManager
    - connection : Connection
    --
    + {static} getInstance() : DatabaseManager
    + getConnection() : Connection
    + close() : void
}
class PlayerDAO <<persist>> {
    + save(player) : int
    + findByUsername(name) : Player
    + exists(name) : boolean
}
class GameDAO <<persist>> {
    + save(game, winnerId, sec) : int
    + findRecent(limit) : List
}
class ScoreDAO <<persist>> {
    + updateScore(playerId, result) : void
    + getTopScores(limit) : List<ScoreEntry>
}
class ScoreEntry <<persist>> {
    + username : String
    + gamesPlayed : int
    + gamesWon : int
    + totalPoints : int
}

' --- Relations : implémentation ---
BoardViewListener <|.. GameController

' --- Relations : BoardView ---
GameController --> BoardView     : rafraîchit
BoardView      --> BoardViewListener : notifie

' --- Relations : Controller → AppController (navigation) ---
MenuController   --> AppController : navigue
LoginController  --> AppController : navigue
EndGameController --> AppController : navigue

' --- Relations : Controller utilise Model ---
GameController ..> Game : délègue

' --- Relations : Persistence ---
PlayerDAO ..> DatabaseManager
GameDAO   ..> DatabaseManager
ScoreDAO  ..> DatabaseManager
ScoreDAO  ..> ScoreEntry : produit

' --- Relations : Controller utilise Persistence ---
GameController   ..> GameDAO  : enregistre
ScoresController ..> ScoreDAO : interroge

note top of GameController
  <b>Pièce maîtresse du MVC</b>
  Implémente BoardViewListener,
  reçoit les clics et drag & drop,
  délègue au Model, rafraîchit BoardView,
  lance l'IA dans un Task<Move>.
end note

note top of AppController
  <b>Routeur central (JavaFX)</b>
  Utilise FXMLLoader pour charger
  chaque .fxml et Stage.setScene()
  pour la navigation entre écrans.
end note

note bottom of DatabaseManager
  <b>Pattern Singleton</b>
  Une seule connexion JDBC partagée
  par tous les DAOs. Credentials lus
  depuis config.properties.
end note

note right of BoardView
  <b>Vue programmatique (pas FXML)</b>
  Extends GridPane. Affiche les cases
  (Rectangle) et pions (Circle).
  Drag & drop natif JavaFX.
  Aucune règle métier ici !
end note

legend bottom
  <back:#FDEDEC>   </back> View (JavaFX)   <back:#E9F7EF>   </back> Controller (@FXML)   <back:#F4ECF7>   </back> Persistence   <back:#EBF5FB>   </back> Model (rappel)   <back:#FEF9E7>   </back> Vues FXML (fichiers XML)
  ──▷ Héritage   ┄┄▷ Implémentation / Dépendance   ◆── Composition   ◇── Agrégation
endlegend

@enduml
