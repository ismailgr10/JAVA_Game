@startuml NavigationDiagram
title Diagramme de Navigation — Jeu de Dames

skinparam backgroundColor #FEFEFE
skinparam state {
    BackgroundColor #D9A96E
    BorderColor #3E2A20
    FontColor #3E2A20
    ArrowColor #3E2A20
    ArrowFontColor #3E2A20
}

[*] --> MenuView : lancement de l'application

state MenuView {
    [*] --> Menu
}

state LoginView {
    [*] --> Configuration
}

state GameView {
    [*] --> Jeu
}

state ScoresView {
    [*] --> Scores
}

state EndGameView {
    [*] --> FinDePartie
}

MenuView --> LoginView   : Jouer (vs Humain / vs IA)
MenuView --> ScoresView  : Scores
MenuView --> [*]         : Quitter

LoginView --> GameView   : Confirmer (noms + mode saisis)

GameView --> EndGameView : Partie terminée\n(victoire / nul / abandon)
GameView --> MenuView    : Retour au menu

EndGameView --> MenuView : Rejouer / Menu

ScoresView --> MenuView  : Retour

@enduml
