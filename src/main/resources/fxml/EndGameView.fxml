<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.ensa.checkers.controller.EndGameController"
           prefHeight="360.0" prefWidth="480.0"
           styleClass="view-wood-bg">

    <VBox styleClass="panel-cream"
          maxWidth="380.0" spacing="14.0" alignment="CENTER"
          StackPane.alignment="CENTER">
        <padding>
            <Insets bottom="32.0" left="36.0" right="36.0" top="32.0"/>
        </padding>

        <Label text="PARTIE TERMINÉE"
               style="-fx-font-family: 'Montserrat', 'Segoe UI', sans-serif;
                      -fx-font-size: 22px; -fx-font-weight: bold;
                      -fx-text-fill: -text-on-light;"/>

        <Separator/>

        <Label fx:id="resultLabel" styleClass="label-value"
               text="—" wrapText="true" style="-fx-font-size: 20px;"/>

        <Region prefHeight="10.0"/>

        <HBox spacing="12.0" alignment="CENTER">
            <Button text="↩  REJOUER"
                    styleClass="button-primary"
                    onAction="#onPlayAgain"/>
            <Button text="⌂  MENU"
                    styleClass="button-primary"
                    onAction="#onBackToMenu"/>
        </HBox>
    </VBox>

</StackPane>
