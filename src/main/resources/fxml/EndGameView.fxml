<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
           prefHeight="560.0" prefWidth="730.0"
           styleClass="view-wood-bg"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.ensa.checkers.controller.EndGameController">
   <children>
      <VBox alignment="CENTER" prefHeight="560.0" prefWidth="730.0" spacing="40.0">
         <children>
            <Label styleClass="title-h1" text="PARTIE TERMINÉE">
               <VBox.margin>
                  <Insets top="40.0" />
               </VBox.margin>
            </Label>
            <Label fx:id="labelResultat" styleClass="title-h2" text="—" wrapText="true" />
            <VBox alignment="CENTER" spacing="18.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#rejouer"        styleClass="button-wood" text="↩  REJOUER" />
                  <Button mnemonicParsing="false" onAction="#retournerAuMenu" styleClass="button-wood" text="⌂  RETOUR AU MENU" />
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</StackPane>
