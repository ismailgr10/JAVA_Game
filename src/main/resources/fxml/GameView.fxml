<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ensa.checkers.controller.GameController"
            prefHeight="640.0" prefWidth="820.0"
            styleClass="view-game-bg">

    <!-- ==================== CENTRE : plateau ==================== -->
    <center>
        <StackPane fx:id="boardContainer" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="16.0" left="16.0" right="0.0" top="16.0"/>
            </padding>
        </StackPane>
    </center>

    <!-- ==================== DROITE : infos ====================== -->
    <right>
        <VBox spacing="12.0" prefWidth="210.0" alignment="TOP_CENTER">
            <padding>
                <Insets bottom="16.0" left="8.0" right="16.0" top="16.0"/>
            </padding>

            <!-- Joueur courant -->
            <VBox styleClass="panel-cream" spacing="6.0" alignment="CENTER">
                <Label text="JOUEUR COURANT" styleClass="label-info"/>
                <Label fx:id="currentPlayerLabel" styleClass="label-value" text="—"/>
            </VBox>

            <!-- Captures -->
            <VBox styleClass="panel-cream" spacing="8.0" alignment="CENTER_LEFT">
                <Label text="CAPTURES" styleClass="label-info" HBox.hgrow="ALWAYS"/>
                <Separator/>
                <HBox spacing="8.0" alignment="CENTER_LEFT">
                    <Label text="⚪" style="-fx-font-size:18px;"/>
                    <Label text="BLANC :" styleClass="label-capture"/>
                    <Label fx:id="captureWhiteLabel" styleClass="label-capture" text="0"/>
                </HBox>
                <HBox spacing="8.0" alignment="CENTER_LEFT">
                    <Label text="⚫" style="-fx-font-size:18px;"/>
                    <Label text="NOIR :" styleClass="label-capture"/>
                    <Label fx:id="captureBlackLabel" styleClass="label-capture" text="0"/>
                </HBox>
            </VBox>

            <!-- Minuteur -->
            <VBox styleClass="panel-cream" spacing="6.0" alignment="CENTER">
                <Label text="MINUTEUR" styleClass="label-info"/>
                <Label fx:id="timerLabel" styleClass="label-value" text="00:00"/>
            </VBox>

            <!-- Spacer -->
            <Region VBox.vgrow="ALWAYS"/>

            <!-- Boutons -->
            <Button fx:id="abandonButton"
                    text="ABANDONNER"
                    styleClass="button-danger"
                    maxWidth="Infinity"
                    onAction="#onAbandon"/>
            <Button text="RETOUR AU MENU"
                    styleClass="button-primary"
                    maxWidth="Infinity"
                    onAction="#onRetourMenu"/>
        </VBox>
    </right>

</BorderPane>
