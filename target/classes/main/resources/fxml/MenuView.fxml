<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
           prefHeight="560.0" prefWidth="730.0"
           styleClass="view-wood-bg"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.ensa.checkers.controller.MenuController">
   <children>
      <VBox alignment="CENTER" prefHeight="560.0" prefWidth="730.0" spacing="40.0">
         <children>
            <Label styleClass="title-h1" text="JEU DE DAMES">
               <VBox.margin>
                  <Insets top="40.0" />
               </VBox.margin>
            </Label>
            <VBox alignment="CENTER" spacing="18.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#onJouerHumain" styleClass="button-wood" text="JOUER VS HUMAIN" />
                  <Button mnemonicParsing="false" onAction="#onJouerIA"      styleClass="button-wood" text="JOUER VS IA" />
                  <Button mnemonicParsing="false" onAction="#onScores"        styleClass="button-wood" text="TABLEAU DES SCORES" />
                  <Button mnemonicParsing="false" onAction="#onQuitter"       styleClass="button-wood" text="QUITTER" />
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</StackPane>
